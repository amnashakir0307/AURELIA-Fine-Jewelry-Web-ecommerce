                      <label className="block text-xs uppercase text-stone-700 font-semibold mb-2">Select Size</label>
                      <div className="flex space-x-2">
                        {selectedProduct.sizes.map((sz) => (
                          <button
                            key={sz}
                            onClick={() => setSelectedSize(sz)}
                            className={`px-3 py-1.5 rounded-lg text-xs font-mono border transition ${
                              selectedSize === sz ? 'bg-[#D4AF37] text-white border-[#D4AF37]' : 'border-stone-300 hover:border-stone-900'
                            }`}
                          >
                            {sz}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  <p className="text-xs text-stone-600 leading-relaxed font-light mb-6">{selectedProduct.description}</p>
                </div>

                <button
                  onClick={() => { addToCart(selectedProduct, selectedSize); setSelectedProduct(null); }}
                  className="w-full py-4 bg-[#D4AF37] text-white hover:bg-stone-900 transition uppercase text-xs tracking-[0.2em] font-medium rounded-xl shadow-lg flex items-center justify-center space-x-2"
                >
                  <ShoppingBag size={16} />
                  <span>Add To Shopping Cart</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Liked Items Drawer / Wishlist Screen */}
      {isWishlistOpen && (
        <div className="fixed inset-0 z-50 bg-stone-900/50 backdrop-blur-sm flex justify-end">
          <div className="w-full max-w-md bg-white h-full shadow-2xl flex flex-col justify-between p-6">
            <div className="flex justify-between items-center border-b pb-4">
              <h2 className="font-serif text-lg font-medium text-stone-900 uppercase flex items-center space-x-2">
                <Heart size={18} className="text-[#D4AF37] fill-[#D4AF37]" />
                <span>Favorites ({wishlist.length})</span>
              </h2>
              <button onClick={() => setIsWishlistOpen(false)} className="p-2 text-stone-400 hover:text-stone-900">
                <X size={20} />
              </button>
            </div>

            {wishlist.length === 0 ? (
              <div className="flex-1 flex flex-col items-center justify-center text-center space-y-4">
                <Heart size={48} className="text-stone-300" />
                <p className="text-stone-600 font-serif">No liked items yet</p>
              </div>
            ) : (
              <div className="flex-1 overflow-y-auto py-4 space-y-4 divide-y">
                {wishlist.map((item) => (
                  <div key={item.id} className="pt-4 flex items-center space-x-4">
                    <img src={item.image} alt={item.name} className="w-16 h-16 object-cover rounded-lg border" />
                    <div className="flex-1">
                      <h4 className="font-serif text-sm font-medium line-clamp-1">{item.name}</h4>
                      <p className="text-xs text-[#D4AF37] font-bold">${item.price.toLocaleString()}</p>
                    </div>
                    <button 
                      onClick={() => { addToCart(item); toggleWishlist(item); }}
                      className="p-2 bg-[#D4AF37] text-white rounded-lg text-xs"
                    >
                      Add To Cart
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {/* Sliding Cart Drawer */}
      {isCartOpen && (
        <div className="fixed inset-0 z-50 bg-stone-900/50 backdrop-blur-sm flex justify-end">
          <div className="w-full max-w-md bg-white h-full shadow-2xl flex flex-col justify-between p-6">
            <div className="flex justify-between items-center border-b pb-4">
              <h2 className="font-serif text-lg font-medium text-stone-900 uppercase">Cart ({cart.reduce((a, c) => a + c.qty, 0)})</h2>
              <button onClick={() => setIsCartOpen(false)} className="p-2 text-stone-400 hover:text-stone-900">
                <X size={20} />
              </button>
            </div>

            {cart.length === 0 ? (
              <div className="flex-1 flex flex-col items-center justify-center text-center space-y-4">
                <ShoppingBag size={48} className="text-stone-300" />
                <p className="text-stone-600 font-serif">Your cart is empty</p>
              </div>
            ) : (
              <div className="flex-1 overflow-y-auto py-4 space-y-4 divide-y">
                {cart.map((item) => (
                  <div key={item.id + item.selectedSize} className="pt-4 flex items-center space-x-4">
                    <img src={item.image} alt={item.name} className="w-16 h-16 object-cover rounded-lg border" />
                    <div className="flex-1">
                      <h4 className="font-serif text-sm font-medium line-clamp-1">{item.name}</h4>
                      <p className="text-[10px] text-stone-400">Size: {item.selectedSize}</p>
                      <p className="text-xs text-stone-500">${item.price.toLocaleString()}</p>
                      <div className="flex items-center space-x-2 mt-2">
                        <button onClick={() => updateCartQty(item.id, item.selectedSize, -1)} className="p-1 border rounded"><Minus size={12} /></button>
                        <span className="text-xs font-mono px-2">{item.qty}</span>
                        <button onClick={() => updateCartQty(item.id, item.selectedSize, 1)} className="p-1 border rounded"><Plus size={12} /></button>
                      </div>
                    </div>
                    <button onClick={() => removeFromCart(item.id, item.selectedSize)} className="text-stone-400 hover:text-red-500"><X size={16} /></button>
                  </div>
                ))}
              </div>
            )}

            {cart.length > 0 && (
              <div className="border-t pt-4 space-y-3">
                <div className="flex justify-between text-base font-bold">
                  <span>Total</span>
                  <span className="font-serif text-xl text-[#D4AF37]">${grandTotal.toLocaleString()}</span>
                </div>
                <button
                  onClick={() => { setIsCartOpen(false); setCheckoutOpen(true); setCheckoutStep(1); }}
                  className="w-full py-4 bg-[#D4AF37] text-white hover:bg-stone-900 transition uppercase text-xs tracking-widest font-medium rounded-xl shadow-lg"
                >
                  Proceed To Real Checkout
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Real E-Commerce Checkout Modal */}
      {checkoutOpen && (
        <div className="fixed inset-0 z-50 bg-stone-900/70 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-xl w-full p-8 shadow-2xl relative border border-stone-200 max-h-[90vh] overflow-y-auto">
            <button onClick={() => setCheckoutOpen(false)} className="absolute top-4 right-4 text-stone-400 hover:text-stone-900">
              <X size={20} />
            </button>

            {checkoutStep === 1 && (
              <form onSubmit={(e) => { e.preventDefault(); setCheckoutStep(2); }} className="space-y-4">
                <h3 className="text-2xl font-serif text-stone-900 text-center mb-6">Shipping Address</h3>

                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">First Name</label>
                    <input
                      required
                      type="text"
                      value={shippingForm.firstName}
                      onChange={(e) => setShippingForm({ ...shippingForm, firstName: e.target.value })}
                      className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                  <div>
                    <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Last Name</label>
                    <input
                      required
                      type="text"
                      value={shippingForm.lastName}
                      onChange={(e) => setShippingForm({ ...shippingForm, lastName: e.target.value })}
                      className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Email Address</label>
                  <input
                    required
                    type="email"
                    value={shippingForm.email}
                    onChange={(e) => setShippingForm({ ...shippingForm, email: e.target.value })}
                    className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                  />
                </div>

                <div>
                  <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Street Address</label>
                  <input
                    required
                    type="text"
                    placeholder="House / Villa No, Street"
                    value={shippingForm.address}
                    onChange={(e) => setShippingForm({ ...shippingForm, address: e.target.value })}
                    className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                  />
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">City</label>
                    <input
                      required
                      type="text"
                      value={shippingForm.city}
                      onChange={(e) => setShippingForm({ ...shippingForm, city: e.target.value })}
                      className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                  <div>
                    <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Postal Code</label>
                    <input
                      required
                      type="text"
                      value={shippingForm.postalCode}
                      onChange={(e) => setShippingForm({ ...shippingForm, postalCode: e.target.value })}
                      className="w-full border border-stone-300 rounded-xl p-3 text-xs outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                </div>

                <button
                  type="submit"
                  className="w-full py-4 bg-[#D4AF37] text-white hover:bg-stone-900 transition uppercase text-xs tracking-widest font-medium rounded-xl shadow-lg mt-4"
                >
                  Continue To Payment
                </button>
              </form>
            )}

            {checkoutStep === 2 && (
              <form onSubmit={handleCompleteOrder} className="space-y-4">
                <h3 className="text-2xl font-serif text-stone-900 text-center mb-6">Payment Method</h3>

                <div className="grid grid-cols-3 gap-2 mb-4">
                  {[
                    { id: 'card', name: 'Credit Card' },
                    { id: 'cod', name: 'Cash On Delivery' },
                    { id: 'apple', name: 'Apple Pay' }
                  ].map((pm) => (
                    <button
                      key={pm.id}
                      type="button"
                      onClick={() => setPaymentMethod(pm.id)}
                      className={`p-3 border rounded-xl text-xs font-medium uppercase tracking-wider transition ${
                        paymentMethod === pm.id ? 'border-[#D4AF37] bg-amber-50 text-[#D4AF37]' : 'border-stone-200'
                      }`}
                    >
                      {pm.name}
                    </button>
                  ))}
                </div>

                {paymentMethod === 'card' && (
                  <div className="space-y-3 bg-stone-50 p-4 rounded-xl border border-stone-200">
                    <div>
                      <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Card Number</label>
                      <input
                        required
                        type="text"
                        placeholder="4532 •••• •••• 8892"
                        value={cardForm.cardNumber}
                        onChange={(e) => setCardForm({ ...cardForm, cardNumber: e.target.value })}
                        className="w-full border border-stone-300 rounded-xl p-2.5 text-xs outline-none bg-white"
                      />
                    </div>
                    <div className="grid grid-cols-2 gap-2">
                      <div>
                        <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">Expiry Date</label>
                        <input
                          required
                          type="text"
                          placeholder="MM/YY"
                          value={cardForm.expiry}
                          onChange={(e) => setCardForm({ ...cardForm, expiry: e.target.value })}
                          className="w-full border border-stone-300 rounded-xl p-2.5 text-xs outline-none bg-white"
                        />
                      </div>
                      <div>
                        <label className="block text-[10px] uppercase text-stone-700 font-semibold mb-1">CVV</label>
                        <input
                          required
                          type="password"
                          maxLength={4}
                          placeholder="•••"
                          value={cardForm.cvv}
                          onChange={(e) => setCardForm({ ...cardForm, cvv: e.target.value })}
                          className="w-full border border-stone-300 rounded-xl p-2.5 text-xs outline-none bg-white"
                        />
                      </div>
                    </div>
                  </div>
                )}

                <div className="pt-2 flex justify-between items-center text-sm font-bold border-t">
                  <span>Payable Amount:</span>
                  <span className="font-serif text-[#D4AF37] text-lg">${grandTotal.toLocaleString()}</span>
                </div>

                <button
                  type="submit"
                  className="w-full py-4 bg-[#D4AF37] text-white hover:bg-stone-900 transition uppercase text-xs tracking-widest font-medium rounded-xl shadow-lg"
                >
                  Place Final Order
                </button>
              </form>
            )}

            {checkoutStep === 3 && placedOrder && (
              <div className="text-center space-y-6">
                <div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
                  <Check size={36} />
                </div>
                <h3 className="text-2xl font-serif text-stone-900">Order Placed Successfully</h3>

                <div className="bg-stone-50 p-4 rounded-xl text-left text-xs space-y-2 border">
                  <div className="flex justify-between"><span className="text-stone-500">Order ID:</span> <span className="font-mono font-semibold">{placedOrder.orderId}</span></div>
                  <div className="flex justify-between"><span className="text-stone-500">Customer:</span> <span className="font-semibold">{placedOrder.customer.firstName} {placedOrder.customer.lastName}</span></div>
                  <div className="flex justify-between"><span className="text-stone-500">Amount Paid:</span> <span className="font-serif text-[#D4AF37] font-bold">${placedOrder.total.toLocaleString()}</span></div>
                </div>

                <button
                  onClick={handleDownloadInvoiceImage}
                  className="w-full py-4 bg-[#D4AF37] text-white hover:bg-stone-900 transition uppercase text-xs tracking-widest font-medium rounded-xl flex items-center justify-center space-x-2 shadow-lg"
                >
                  <Download size={16} />
                  <span>Download Image Invoice (PNG)</span>
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Pure Dark Black Luxury Footer */}
      <footer className="bg-[#0B0B0B] text-white border-t border-[#D4AF37]/30 py-16 mt-auto">
        <div className="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-4 gap-12">
          <div>
            <div className="flex items-center space-x-3 mb-4">
              <img src={BRAND_LOGO} alt="Aura Logo" className="w-10 h-10 rounded-full border border-[#D4AF37]" />
              <span className="font-serif tracking-widest text-xl text-[#D4AF37] font-semibold">AURA</span>
            </div>
            <p className="text-xs text-stone-400 font-light leading-relaxed">
              Exquisite high jewelry crafted with pure 24K gold and GIA-certified ethically sourced diamonds.
            </p>
          </div>

          <div>
            <h4 className="font-serif text-sm text-[#D4AF37] uppercase tracking-wider mb-4 font-semibold">Collections</h4>
            <ul className="text-xs text-stone-400 space-y-2.5 uppercase tracking-wider">
              <li className="hover:text-[#D4AF37] cursor-pointer transition" onClick={() => { setActiveTab('catalog'); setSelectedCategory('rings'); }}>Solitaire Rings</li>
              <li className="hover:text-[#D4AF37] cursor-pointer transition" onClick={() => { setActiveTab('catalog'); setSelectedCategory('bracelets'); }}>Tennis Bracelets</li>
              <li className="hover:text-[#D4AF37] cursor-pointer transition" onClick={() => { setActiveTab('catalog'); setSelectedCategory('bangles'); }}>Filigree Bangles</li>
            </ul>
          </div>

          <div>
            <h4 className="font-serif text-sm text-[#D4AF37] uppercase tracking-wider mb-4 font-semibold">Bespoke Services</h4>
            <ul className="text-xs text-stone-400 space-y-2.5 uppercase tracking-wider">
              <li className="hover:text-[#D4AF37] cursor-pointer transition" onClick={() => setActiveTab('custom')}>Interactive Customizer</li>
              <li className="hover:text-[#D4AF37] cursor-pointer transition" onClick={() => setActiveTab('home')}>Flagship Outlets</li>
            </ul>
          </div>

          <div>
            <h4 className="font-serif text-sm text-[#D4AF37] uppercase tracking-wider mb-4 font-semibold">Boutique Concierge</h4>
            <p className="text-xs text-stone-400 mb-2">Dubai • Karachi • Lahore • Islamabad</p>
            <p className="text-sm text-[#D4AF37] font-mono font-bold">+971 4 800 AURA</p>
          </div>
        </div>

        <div className="max-w-7xl mx-auto px-4 md:px-8 border-t border-stone-900 mt-12 pt-6 text-center text-[11px] text-stone-500 uppercase tracking-widest font-mono">
          © {new Date().getFullYear()} AURA Haute Joaillerie. All rights reserved.
        </div>
      </footer>

    </div>
  );
}
